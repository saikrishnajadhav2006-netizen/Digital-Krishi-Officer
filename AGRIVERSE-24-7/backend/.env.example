PROJECT_NAME="AGRIVERSE-24/7"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database (Default to SQLite for local, change for Postgres)
DATABASE_URL="sqlite:///./agriverse.db"
# DATABASE_URL="postgresql://user:password@hostname:port/dbname"

# Ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral"

# Security (Generate a secure key for production)
SECRET_KEY="your-super-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional official commodity-price integration (data.gov.in / AGMARKNET)
# Obtain the API key and resource ID from the selected official dataset.
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=

# Optional OpenStreetMap Overpass endpoint
OVERPASS_URL=https://overpass-api.de/api/interpreter
